    {
      "name": "Cards - TCGdex GraphQL (Direct query)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status is 200', () => {",
              "  pm.expect(pm.response.code).to.equal(200);",
              "});",
              "pm.test('response has data.cards array', () => {",
              "  const body = pm.response.json();",
              "  pm.expect(body).to.have.property('data');",
              "  pm.expect(body.data).to.have.property('cards').that.is.an('array');",
              "});",
              "pm.test('cards have expected GraphQL fields', () => {",
              "  const cards = pm.response.json().data.cards;",
              "  if (cards.length > 0) {",
              "    const card = cards[0];",
              "    pm.expect(card).to.have.property('id');",
              "    pm.expect(card).to.have.property('name');",
              "    pm.expect(card).to.have.property('image');",
              "    pm.expect(card).to.have.property('category');",
              "    pm.expect(card).to.have.property('set');",
              "    pm.expect(card).to.have.property('variants');",
              "  }",
              "});",
              "pm.test('errors field is absent or attacks with null names are present as null items', () => {",
              "  const body = pm.response.json();",
              "  // TCGdex may return errors[] alongside data when attack names are null.",
              "  // This is expected behaviour — PokeHub filters them out in the mapper.",
              "  if (body.errors) {",
              "    console.log('TCGdex field-level errors (expected):', JSON.stringify(body.errors));",
              "  }",
              "  pm.expect(body.data.cards).to.be.an('array');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "id": "f1e2d3c4-b5a6-7890-fedc-ba9876543210",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "graphql",
          "graphql": {
            "query": "query SearchCards($name: String) {\n  cards(filters: { name: $name }) {\n    id\n    localId\n    name\n    image\n    rarity\n    hp\n    types\n    stage\n    evolveFrom\n    description\n    illustrator\n    retreat\n    regulationMark\n    category\n    set {\n      id\n      name\n      logo\n      symbol\n    }\n    variants {\n      normal\n      holo\n      reverse\n      firstEdition\n    }\n    attacks {\n      name\n      cost\n      damage\n      effect\n    }\n    weaknesses {\n      type\n      value\n    }\n  }\n}",
            "variables": "{\n  \"name\": \"Pikachu\"\n}"
          }
        },
        "url": {
          "raw": "https://api.tcgdex.net/v2/graphql",
          "protocol": "https",
          "host": [
            "api",
            "tcgdex",
            "net"
          ],
          "path": [
            "v2",
            "graphql"
          ]
        },
        "description": "Directly queries the TCGdex GraphQL endpoint using the exact query shape used by the PokeHub backend service. Change the 'name' variable to search for different cards. Note: TCGdex may return an 'errors' array alongside 'data.cards' when some attack fields are null — this is expected and the PokeHub mapper filters those entries out."
      },
      "response": []
    },
