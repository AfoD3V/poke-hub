    {
      "name": "Auth - Logout",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status is 200', () => {",
              "  pm.expect(pm.response.code).to.equal(200);",
              "});",
              "pm.test('cookie cleared', () => {",
              "  const setCookie = pm.response.headers.get('Set-Cookie');",
              "  pm.expect(setCookie || '').to.include('Max-Age=0');",
              "});",
              "pm.collectionVariables.unset('sessionCookie');"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Cookie",
            "value": "{{sessionCookie}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/auth/logout",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "logout"]
        }
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "email",
      "value": "user@example.com"
    },
    {
      "key": "password",
      "value": "Pikachu123"
    },
    {
      "key": "displayName",
      "value": "Trainer"
    },
    {
      "key": "sessionCookie",
      "value": ""
    }
  ]
