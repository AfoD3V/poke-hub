    {
      "name": "Cards - Search (Positive)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status is 200', () => {",
              "  pm.expect(pm.response.code).to.equal(200);",
              "});",
              "pm.test('response has cards array and totalCount', () => {",
              "  const body = pm.response.json();",
              "  pm.expect(body).to.have.property('cards');",
              "  pm.expect(body.cards).to.be.an('array');",
              "  pm.expect(body).to.have.property('totalCount');",
              "  pm.expect(body.totalCount).to.equal(body.cards.length);",
              "});",
              "pm.test('each card has GraphQL-sourced fields (id, name, number, supertype)', () => {",
              "  const body = pm.response.json();",
              "  body.cards.forEach(card => {",
              "    pm.expect(card).to.have.property('id').that.is.a('string');",
              "    pm.expect(card).to.have.property('name').that.is.a('string');",
              "    pm.expect(card).to.have.property('number').that.is.a('string');",
              "    pm.expect(card).to.have.property('supertype').that.is.a('string');",
              "  });",
              "});",
              "pm.test('each card has images with webp URLs', () => {",
              "  const body = pm.response.json();",
              "  body.cards.forEach(card => {",
              "    pm.expect(card).to.have.property('images');",
              "    pm.expect(card.images).to.have.property('small').that.includes('.webp');",
              "    pm.expect(card.images).to.have.property('large').that.includes('.webp');",
              "  });",
              "});",
              "pm.test('each card with setDetails has id, name, logo and symbol', () => {",
              "  const body = pm.response.json();",
              "  body.cards.filter(c => c.setDetails).forEach(card => {",
              "    pm.expect(card.setDetails).to.have.property('id').that.is.a('string');",
              "    pm.expect(card.setDetails).to.have.property('name').that.is.a('string');",
              "    pm.expect(card.setDetails).to.have.property('images');",
              "  });",
              "});",
              "pm.test('no card has a null attack entry (null list items filtered)', () => {",
              "  const body = pm.response.json();",
              "  body.cards.filter(c => c.attacks).forEach(card => {",
              "    card.attacks.forEach(attack => {",
              "      pm.expect(attack).to.not.be.null;",
              "      pm.expect(attack.name).to.be.a('string').and.not.equal('');",
              "      pm.expect(attack.cost).to.be.an('array');",
              "      pm.expect(attack.damage).to.be.a('string');",
              "    });",
              "  });",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
