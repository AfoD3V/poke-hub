    {
      "name": "Health - Status",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/health",
          "host": ["{{baseUrl}}"],
          "path": ["api", "health"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status is 200 or 503', () => {",
              "  pm.expect([200, 503]).to.include(pm.response.code);",
              "});",
              "pm.test('body has ok/database', () => {",
              "  const body = pm.response.json();",
              "  pm.expect(body).to.have.property('ok');",
              "  pm.expect(body).to.have.property('database');",
              "});"
            ]
          }
        }
      ]
    },
